<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YAML.Linter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engine.Client\Engine.Client.csproj" />
    <ProjectReference Include="..\..\Content.Client\MyGame.csproj" />
    <ProjectReference Include="..\..\Engine.Server\Engine.Server.csproj" />
    <ProjectReference Include="..\..\Engine.Shared\Engine.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputPath>..\..\bin\$(AssemblyName)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
