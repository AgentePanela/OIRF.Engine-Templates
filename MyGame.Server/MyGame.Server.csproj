<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.Server\Engine.Server.csproj" />
    <ProjectReference Include="..\Engine\Engine.Shared\Engine.Shared.csproj" />
    <ProjectReference Include="..\MyGame.Shared\MyGame.Shared.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputPath>..\bin\$(AssemblyName)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE;PUBLISH</DefineConstants>
  </PropertyGroup>
</Project>
